# Copy to server/.env for local development. Never commit the real .env.

# Port for local runs (Render sets PORT itself).
# PORT=8787

# Resend (https://resend.com). Without a key, codes print in this terminal.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Tesella <no-reply@yourdomain.com>

# Lets accounts play ranked without verifying their email. Handy locally;
# never set it on the live server.
SKIP_EMAIL_VERIFY=1

# Where data.json and its backups live (default: this folder).
# DATA_DIR=/var/data

# Google sign-in (parked in the client for now).
# GOOGLE_CLIENT_ID=
